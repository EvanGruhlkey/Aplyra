LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_USE_VISION=false
OLLAMA_NUM_CTX=16384

# Open-weight model served on remote GPU compute (no model API billing):
# LLM_PROVIDER=self_hosted
# SELF_HOSTED_MODEL=browser-use/bu-30b-a3b-preview
# SELF_HOSTED_BASE_URL=http://model:8001/v1
# SELF_HOSTED_API_KEY=not-needed

# To use an API model instead:
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=

# One-user remote worker (use an API model or remotely reachable Ollama host)
# FLY_APP_NAME=your-private-aplyra-worker
# FLYCTL_PATH=path-to-flyctl-if-it-is-not-on-PATH
# APLYRA_CONTROL_TOKEN=generate-a-long-random-value
# REMOTE_OLLAMA_MODEL=qwen3:1.7b
